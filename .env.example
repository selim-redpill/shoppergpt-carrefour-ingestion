MONGO_URI=mongodb://localhost:27017

# ENV controls the default DB name (can be overridden by MONGO_DB):
#   dev  → waib_carrefour_traiteur_dev_db
#   prod → waib_carrefour_traiteur_db
ENV=dev

# Override the DB name directly (optional — takes priority over ENV)
# MONGO_DB=waib_carrefour_traiteur_dev_db

# Logging level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# Logging format: console | json
# console → pretty coloured output for local dev / Python terminal
# json    → newline-delimited JSON for K8s / Docker / log aggregators
# (default: auto-detect — json if no TTY, console otherwise)
LOG_FORMAT=console

# ── Gemini classification ─────────────────────────────────────────────────────
# Required when running --products: menu_step, dish_role, drink_role and
# could_fit_event are all classified by Gemini (cached per product afterwards).
# Local dev → an AI Studio key. On GCP → leave empty and set
# GOOGLE_GENAI_USE_VERTEXAI=true
# Required with Vertex (GCP_PROJECT is accepted as an alias):
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global instead, which uses the instance's ADC.
GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# Required with Vertex (GCP_PROJECT is accepted as an alias):
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# ── Embeddings ────────────────────────────────────────────────────────────────
# Required when running --pinecone.
OPENAI_API_KEY=sk-...

# Model and dimensions must match the target index (default: 1536 dims)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── Pinecone vector store ─────────────────────────────────────────────────────
# Required when running --pinecone.
PINECONE_API_KEY=pcsk_...

# Target index name (default follows ENV above:
#   dev → waib-carrefour-dev-large | prod → waib-carrefour-prod-large)
# PINECONE_INDEX_NAME=waib-carrefour-dev-large

# ── Feature flags ─────────────────────────────────────────────────────────────
# When false (default), "compose-it-yourself" products (… au choix / à composer)
# are excluded from both MongoDB and Pinecone — they never surface in the pipeline.
# Set to true to re-enable storage and embedding of those products.
INGEST_NON_RECOMMENDABLE=false
